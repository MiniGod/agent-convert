{
  "name": "agent-convert",
  "version": "0.1.0",
  "description": "Convert sessions between Claude Code and Copilot CLI",
  "type": "module",
  "bin": {
    "agent-convert": "./bin/agent-convert.js"
  },
  "scripts": {
    "build": "bun build convert.ts --outfile bin/agent-convert.js --target bun && sed -i '1s|.*|#!/usr/bin/env bun|' bin/agent-convert.js && chmod +x bin/agent-convert.js",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "copilot",
    "session",
    "converter",
    "cli",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiniGod/agent-convert.git"
  },
  "bugs": {
    "url": "https://github.com/MiniGod/agent-convert/issues"
  },
  "homepage": "https://github.com/MiniGod/agent-convert#readme",
  "engines": {
    "bun": ">=1.0"
  },
  "files": [
    "bin/",
    "convert.ts",
    "README.md"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7"
  }
}
